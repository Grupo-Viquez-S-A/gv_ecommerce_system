# Origen exacto del frontend autorizado para invocar las Edge Functions.
# No agregue una barra al final ni use "*".
CORS_ALLOWED_ORIGIN=https://app.ejemplo.com

# URL incluida en los correos de acceso y notificaciones.
SITE_URL=https://app.ejemplo.com

# URL final donde el cliente/representante define o restablece su contrasena.
ECOMMERCE_CLIENT_REDIRECT_URL=https://app.ejemplo.com/restablecer-contrasena

# SMTP con TLS directo (puerto 465).
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=465
SMTP_USERNAME=usuario-smtp
SMTP_PASSWORD=reemplazar-en-supabase-secrets
SMTP_FROM_EMAIL=no-reply@ejemplo.com
SMTP_FROM_NAME=Grupo Viquez S.A
